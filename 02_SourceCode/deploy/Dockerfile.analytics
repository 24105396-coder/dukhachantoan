# Dockerfile cho Railway khi nối kho GitHub (ngữ cảnh build = gốc kho). Bản sao của 02_SourceCode/python-service/Dockerfile.
# Railway: RAILWAY_DOCKERFILE_PATH=02_SourceCode/deploy/Dockerfile.analytics
FROM python:3.12-slim
WORKDIR /srv
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
COPY 02_SourceCode/python-service/requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && pip install --no-cache-dir -r requirements.txt
COPY 02_SourceCode/python-service/app ./app
COPY 02_SourceCode/python-service/kiem_dinh_du_lieu.py 02_SourceCode/python-service/run.py ./
RUN useradd --system --uid 10001 --no-create-home analytics && chown -R analytics:analytics /srv
USER analytics
EXPOSE 8001
ENV UVICORN_HOST=dual PORT=8001
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s CMD curl -fsS "http://localhost:${PORT:-8001}/healthz" || exit 1
# run.py nghe cả IPv4 và IPv6 (Railway: mạng riêng IPv6, healthcheck IPv4); đọc PORT do nền tảng cấp
CMD ["python", "run.py"]
