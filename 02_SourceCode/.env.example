# Sao chép thành .env ở cùng thư mục với compose.yaml rồi chỉnh nếu cần.
# Mọi giá trị dưới đây là dữ liệu mô phỏng cho môi trường học tập.
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8081
APP_KEY=
LOG_LEVEL=info
# Nhật ký tách theo ngày (storage/logs/laravel-YYYY-MM-DD.log), giữ LOG_DAILY_DAYS ngày gần nhất
LOG_STACK=daily
LOG_DAILY_DAYS=14

DB_DATABASE=dukhach
DB_USERNAME=dukhach
DB_PASSWORD=dukhach_secret
DB_ROOT_PASSWORD=root_secret
DB_FORWARD_PORT=3308

APP_FORWARD_PORT=8081
ANALYTICS_FORWARD_PORT=8002
ANALYTICS_TOKEN=dev-analytics-token

# Chỉ đặt "*" khi chạy sau proxy của nền tảng (Railway/Render)
TRUSTED_PROXIES=
SEED_DEMO_PASSWORD=DuKhach@2026
SESSION_SECURE_COOKIE=false
# Bản đồ nền: osm (OpenStreetMap, mặc định) hoặc google
MAP_PROVIDER=osm
# Chế độ mô phỏng (nút chạy kịch bản) và tỉ lệ lỗi SMS mô phỏng để kiểm thử thử lại
SIMULATION_MODE=true
SMS_SIM_FAIL_RATE=0.1
