# DuKhachAnToan – mẫu .env cho chạy Laravel NGOÀI Docker (php artisan serve, MySQL ở cổng 3308 của compose).
# Chạy bằng Docker thì dùng 02_SourceCode/.env.example (compose.yaml đã đặt sẵn phần lớn biến dưới đây).
# Sao chép thành .env rồi chạy: php artisan key:generate. Không đưa .env vào Git.
# Mọi giá trị là dữ liệu mô phỏng cho môi trường học tập; triển khai thật phải đổi toàn bộ bí mật.

# ---------- Ứng dụng ----------
APP_NAME=DuKhachAnToan
# local | production | testing
APP_ENV=local
# Để trống, sinh bằng: php artisan key:generate (khóa mã hóa phiên/cookie)
APP_KEY=
# Chỉ bật true khi phát triển; production luôn false để không lộ stack trace
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN
# Hiển thị ở chân trang (Mục 2.4 Đề thi)
APP_VERSION=1.0.0
APP_TEAM_NAME=DuKhachAnToan
APP_MAINTENANCE_DRIVER=file

# Số vòng băm bcrypt cho mật khẩu (test dùng 4 để chạy nhanh)
BCRYPT_ROUNDS=12

# ---------- Nhật ký ----------
LOG_CHANNEL=stack
# daily: tách tệp theo ngày storage/logs/laravel-YYYY-MM-DD.log, giữ LOG_DAILY_DAYS ngày
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# ---------- Cơ sở dữ liệu MySQL 8 ----------
# Ngoài Docker: MySQL của compose ánh xạ ra 127.0.0.1:3308 (DB_FORWARD_PORT). Trong Docker: host db, cổng 3306.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3308
DB_DATABASE=dukhach
DB_USERNAME=dukhach
# Giá trị mô phỏng, khớp 02_SourceCode/.env.example và 03_Database/00_init.sql
DB_PASSWORD=dukhach_secret
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ---------- Phiên và cookie ----------
# Phiên lưu trong bảng sessions; cookie HttpOnly, SameSite=Lax
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Bật true khi chạy HTTPS để cookie chỉ gửi qua kênh mã hóa
SESSION_SECURE_COOKIE=false

# ---------- Bộ đệm, hàng đợi, tệp, thư ----------
CACHE_STORE=database
# Bộ đệm dữ liệu trang công khai (giây); 0 = tắt
PAGE_CACHE_STORE=file
PAGE_CACHE_TTL=60
# database: hàng đợi trong bảng jobs; entrypoint Docker chạy queue:work + scheduler nền
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
# Hệ thống không gửi thư thật; log ghi nội dung thư vào nhật ký
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@dukhach.test"
MAIL_FROM_NAME="${APP_NAME}"

# ---------- Bảo mật mạng ----------
# Rỗng = không tin proxy nào; đặt dải IP proxy (hoặc "*") khi chạy sau reverse proxy/PaaS
TRUSTED_PROXIES=

# ---------- Mô-đun Python (FastAPI) ----------
# Ngoài Docker: dịch vụ analytics ánh xạ ra cổng 8002. Tắt dịch vụ thì đối sánh dùng dự phòng PHP (vùng + haversine).
ANALYTICS_URL=http://127.0.0.1:8002
# Token dùng chung giữa app và Python (giá trị mô phỏng; phải khớp ANALYTICS_TOKEN của dịch vụ Python)
ANALYTICS_TOKEN=dev-analytics-token
# Thời gian chờ tối đa (giây) trước khi chuyển sang dự phòng
ANALYTICS_TIMEOUT=3

# ---------- Cảnh báo và thông báo ----------
# Bật nút chạy kịch bản mô phỏng và nhãn [MÔ PHỎNG]
SIMULATION_MODE=true
# Tỉ lệ thất bại ngẫu nhiên của SMS mô phỏng (0..1) để kiểm thử thử lại; 0 = luôn thành công
SMS_SIM_FAIL_RATE=0.1
# Bản đồ nền: google (Google Maps, mặc định) hoặc osm (OpenStreetMap)
MAP_PROVIDER=google

# ---------- Dữ liệu mẫu ----------
# Mật khẩu chung của 4 tài khoản mẫu khi seed (giá trị mô phỏng)
SEED_DEMO_PASSWORD=DuKhach@2026

# ---------- Inertia ----------
INERTIA_SSR_ENABLED=false
INERTIA_SSR_URL=http://127.0.0.1:13714
