    "/api/v1/payments/sandbox/ipn": {
      "post": {
        "tags": [
          "Payments"
        ],
        "summary": "IPN của cổng thanh toán mô phỏng (server-to-server)",
        "description": "Chữ ký = HMAC-SHA256(secret, http_build_query(ksort(payload))) với RFC3986. Chữ ký sai hoặc số tiền lệch → 400. Gọi lặp lại là idempotent.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SandboxIpn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Đã xử lý",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "txn_ref": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "initiated",
                        "succeeded",
                        "failed",
                        "cancelled",
                        "refunded"
                      ]
                    },
                    "booking_status": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Chữ ký không hợp lệ / giao dịch không tồn tại / số tiền lệch"
          },
          "422": {
            "description": "Thiếu trường bắt buộc"
          }
        }
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "tags": [
