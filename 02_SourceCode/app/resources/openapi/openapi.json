{
  "openapi": "3.0.3",
  "info": {
    "title": "DuKhachAnToan API",
    "version": "0.1.0",
    "description": "API mở của hệ thống cảnh báo rủi ro và hỗ trợ du khách (CSE703073 ĐT-15). Giới hạn 60 yêu cầu/phút/IP. Pha 1: sức khỏe hệ thống và số liệu tổng quan; các endpoint cảnh báo, vùng, danh bạ, hướng dẫn bổ sung ở pha 2."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Tình trạng hệ thống",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Mất kết nối CSDL"
          }
        }
      }
    },
    "/stats/overview": {
      "get": {
        "summary": "KPI công khai (không dữ liệu cá nhân)",
        "parameters": [
          {
            "name": "locale",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "vi",
                "en"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatsOverview"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "fail"
            ]
          },
          "db": {
            "type": "string"
          },
          "analytics": {
            "type": "string",
            "enum": [
              "ok",
              "down"
            ]
          },
          "queue": {
            "type": "object",
            "nullable": true,
            "properties": {
              "queued": {
                "type": "integer"
              },
              "failed": {
                "type": "integer"
              },
              "jobs": {
                "type": "integer"
              },
              "failed_jobs": {
                "type": "integer"
              }
            }
          },
          "last_weather_fetch": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "StatsOverview": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "zones": {
                "type": "integer"
              },
              "alerts_active": {
                "type": "integer"
              },
              "trips_active": {
                "type": "integer"
              },
              "contacts": {
                "type": "integer"
              },
              "national_level": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              "national_label": {
                "type": "string"
              }
            }
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}