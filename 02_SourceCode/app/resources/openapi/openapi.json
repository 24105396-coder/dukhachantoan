    "/api/v1/search": {
      "get": {
        "tags": [
          "Discovery"
        ],
        "summary": "Tìm kiếm ngữ nghĩa (TF-IDF Python), tự động dự phòng FULLTEXT MySQL",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 100
            },
            "required": true
          },
          {
            "name": "locale",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "vi",
                "en"
              ],
              "default": "vi"
            },
            "description": "Ngôn ngữ nội dung / content language"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "engine": {
                      "type": "string",
                      "enum": [
                        "semantic",
                        "fallback"
                      ]
                    },
                    "took_ms": {
                      "type": "integer"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SearchHit"
                      }
                    }
                  }
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
