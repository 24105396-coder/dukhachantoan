{
  "openapi": "3.1.0",
  "info": {
    "title": "DuKhachAnToan API",
    "version": "1.0.0",
    "description": "API mở của hệ thống cảnh báo rủi ro và hỗ trợ du khách (CSE703073 ĐT-15). JSON, không cần đăng nhập, giới hạn 60 yêu cầu/phút/IP; mọi cảnh báo kèm nguồn và thời điểm cập nhật. Dữ liệu thời tiết: Open-Meteo (CC BY 4.0); ranh giới: © OpenStreetMap contributors (ODbL).",
    "license": {
      "name": "Sản phẩm học thuật",
      "identifier": "CC-BY-4.0"
    }
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "tags": [
    {
      "name": "system"
    },
    {
      "name": "alerts"
    },
    {
      "name": "geo"
    },
    {
      "name": "weather"
    },
    {
      "name": "support"
    },
    {
      "name": "trips"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Tình trạng hệ thống",
        "tags": [
          "system"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Mất kết nối CSDL"
          }
        }
      }
    },
    "/stats/overview": {
      "get": {
        "summary": "KPI công khai (không dữ liệu cá nhân)",
        "tags": [
          "system"
        ],
        "parameters": [
          {
            "name": "locale",
            "in": "query",
            "description": "Ngôn ngữ nội dung (vi mặc định).",
            "schema": {
              "type": "string",
              "enum": [
                "vi",
                "en"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatsOverview"
                }
              }
            }
          }
        }
      }
    },
    "/alerts": {
      "get": {
        "summary": "Danh sách cảnh báo (mặc định đang hiệu lực)",
        "tags": [
          "alerts"
        ],
        "parameters": [
          {
            "name": "severity",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            }
          },
          {
            "name": "province",
            "in": "query",
            "description": "Mã tỉnh, ví dụ KH",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hazard",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "active",
            "in": "query",
            "description": "1 (mặc định) chỉ đang hiệu lực; 0 gồm cả đã hết hạn",
            "schema": {
              "type": "integer",
              "enum": [
                0,
                1
              ]
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "locale",
            "in": "query",
            "description": "Ngôn ngữ nội dung (vi mặc định).",
            "schema": {
              "type": "string",
              "enum": [
                "vi",
                "en"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AlertCard"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/PageMeta"
                    },
                    "links": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Quá giới hạn tần suất",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/alerts/{code}": {
      "get": {
        "summary": "Chi tiết cảnh báo (không có số hành trình bị ảnh hưởng)",
        "tags": [
          "alerts"
        ],
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "description": "Mã cảnh báo AL-xxxx",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "locale",
            "in": "query",
            "description": "Ngôn ngữ nội dung (vi mặc định).",
            "schema": {
              "type": "string",
              "enum": [
                "vi",
                "en"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/AlertDetail"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Không tìm thấy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/alerts.geojson": {
      "get": {
        "summary": "GeoJSON cảnh báo đang hiệu lực (Circle → Point + radius_km; không có hình học → các vùng)",
        "tags": [
          "alerts",
          "geo"
        ],
        "parameters": [
          {
            "name": "locale",
            "in": "query",
            "description": "Ngôn ngữ nội dung (vi mặc định).",
            "schema": {
              "type": "string",
              "enum": [
                "vi",
                "en"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/geo+json": {
                "schema": {
                  "$ref": "#/components/schemas/FeatureCollection"
                }
              }
            }
          }
        }
      }
    },
    "/zones": {
      "get": {
        "summary": "Danh sách vùng kèm điểm rủi ro",
        "tags": [
          "geo"
        ],
        "parameters": [
          {
            "name": "locale",
            "in": "query",
            "description": "Ngôn ngữ nội dung (vi mặc định).",
            "schema": {
              "type": "string",
              "enum": [
                "vi",
                "en"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ZoneCard"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/zones.geojson": {
      "get": {
        "summary": "GeoJSON vùng tô màu theo mức rủi ro (properties: code, name, level, score, active_alerts_count, url)",
        "tags": [
          "geo"
        ],
        "parameters": [
          {
            "name": "locale",
            "in": "query",
            "description": "Ngôn ngữ nội dung (vi mặc định).",
            "schema": {
              "type": "string",
              "enum": [
                "vi",
                "en"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/geo+json": {
                "schema": {
                  "$ref": "#/components/schemas/FeatureCollection"
                }
              }
            }
          }
        }
      }
    },
    "/zones/{code}/weather": {
      "get": {
        "summary": "Thời tiết hiện tại, dự báo 7 ngày (Open-Meteo, CC BY 4.0) và điểm rủi ro của vùng",
        "tags": [
          "weather"
        ],
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "description": "Mã vùng, ví dụ da-nang",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "locale",
            "in": "query",
            "description": "Ngôn ngữ nội dung (vi mặc định).",
            "schema": {
              "type": "string",
              "enum": [
                "vi",
                "en"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "zone": {
                          "type": "object",
                          "properties": {
                            "code": {
                              "type": "string"
                            },
                            "name": {
                              "type": "string"
                            }
                          }
                        },
                        "now": {
                          "anyOf": [
                            {
                              "$ref": "#/components/schemas/WeatherNow"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "forecast": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/ForecastDay"
                          }
                        },
                        "risk": {
                          "type": [
                            "object",
                            "null"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Không tìm thấy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/contacts": {
      "get": {
        "summary": "Danh bạ khẩn cấp (theo tỉnh + số toàn quốc)",
        "tags": [
          "support"
        ],
        "parameters": [
          {
            "name": "province",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "locale",
            "in": "query",
            "description": "Ngôn ngữ nội dung (vi mặc định).",
            "schema": {
              "type": "string",
              "enum": [
                "vi",
                "en"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ContactItem"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/guides": {
      "get": {
        "summary": "Hướng dẫn ứng phó đã xuất bản",
        "tags": [
          "support"
        ],
        "parameters": [
          {
            "name": "hazard",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "locale",
            "in": "query",
            "description": "Ngôn ngữ nội dung (vi mặc định).",
            "schema": {
              "type": "string",
              "enum": [
                "vi",
                "en"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/GuideCard"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/guides/{slug}": {
      "get": {
        "summary": "Chi tiết hướng dẫn (các bước trước – trong – sau, nguồn)",
        "tags": [
          "support"
        ],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "description": "Slug hướng dẫn",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "locale",
            "in": "query",
            "description": "Ngôn ngữ nội dung (vi mặc định).",
            "schema": {
              "type": "string",
              "enum": [
                "vi",
                "en"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/GuideDetail"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Không tìm thấy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/trips/shared/{token}": {
      "get": {
        "summary": "Trạng thái hành trình chia sẻ theo token (không lộ liên hệ)",
        "tags": [
          "trips"
        ],
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "description": "share_token ngẫu nhiên 40 ký tự (tham số nhạy cảm, không phải id)",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]{40}$"
            }
          },
          {
            "name": "locale",
            "in": "query",
            "description": "Ngôn ngữ nội dung (vi mặc định).",
            "schema": {
              "type": "string",
              "enum": [
                "vi",
                "en"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/SharedTrip"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Không tìm thấy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/trips/shared/{token}/checkin": {
      "post": {
        "summary": "Báo an toàn qua liên kết chia sẻ (giới hạn 10 lần/giờ/token); need_help báo cơ quan hỗ trợ mức 4",
        "tags": [
          "trips"
        ],
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "description": "share_token ngẫu nhiên 40 ký tự (tham số nhạy cảm, không phải id)",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]{40}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckinInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Đã ghi nhận",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/CheckinItem"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Không tìm thấy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Dữ liệu không hợp lệ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "429": {
            "description": "Quá giới hạn tần suất",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      },
      "ValidationError": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "fail"
            ]
          },
          "db": {
            "type": "string"
          },
          "analytics": {
            "type": "string",
            "enum": [
              "ok",
              "down"
            ]
          },
          "queue": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "queued": {
                "type": "integer"
              },
              "failed": {
                "type": "integer"
              },
              "jobs": {
                "type": "integer"
              },
              "failed_jobs": {
                "type": "integer"
              }
            }
          },
          "last_weather_fetch": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "StatsOverview": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "zones": {
                "type": "integer"
              },
              "alerts_active": {
                "type": "integer"
              },
              "trips_active": {
                "type": "integer"
              },
              "contacts": {
                "type": "integer"
              },
              "national_level": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              "national_label": {
                "type": "string"
              },
              "alerts_by_severity": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer"
                }
              }
            }
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Hazard": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "icon": {
            "type": [
              "string",
              "null"
            ]
          },
          "color": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "AlertCard": {
        "type": "object",
        "required": [
          "code",
          "severity",
          "headline",
          "source",
          "updated_at_source"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "code": {
            "type": "string",
            "pattern": "^AL-"
          },
          "severity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "severity_label": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "updated",
              "expired",
              "cancelled"
            ]
          },
          "hazard": {
            "$ref": "#/components/schemas/Hazard"
          },
          "headline": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "instructions": {
            "type": [
              "string",
              "null"
            ]
          },
          "zones": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              }
            }
          },
          "geometry": {
            "type": [
              "object",
              "null"
            ],
            "description": "GeoJSON Polygon/MultiPolygon hoặc {type: Circle, center: {lat,lng}, radius_km}"
          },
          "starts_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "ends_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "issued_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "updated_at_source": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "source": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "attribution": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "is_simulated": {
            "type": "boolean"
          },
          "scenario": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "slug": {
