{
  "openapi": "3.1.0",
  "info": {
    "title": "DiSanSo Open Data API",
    "version": "1.0.0",
    "description": "API mở (chỉ đọc) của nền tảng số hóa và diễn giải di sản văn hóa đa ngữ DiSanSo (CSE703073 ĐT-04). Không cần xác thực; giới hạn 60 yêu cầu/phút/IP; CORS *. Nội dung trả về đã địa phương hóa theo tham số `locale`.",
    "license": {
      "name": "CC BY 4.0 (dữ liệu mô tả)",
      "url": "https://creativecommons.org/licenses/by/4.0/"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Docker Compose cục bộ"
    }
  ],
  "tags": [
    {
      "name": "Heritage"
    },
    {
      "name": "Discovery"
    },
    {
      "name": "Tours"
    },
    {
      "name": "Payments"
    },
    {
      "name": "System"
    }
  ],
  "paths": {
    "/api/v1/sites": {
      "get": {
        "tags": [
          "Heritage"
        ],
        "summary": "Danh sách di sản",
        "parameters": [
          {
            "name": "locale",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "vi",
                "en"
              ],
              "default": "vi"
            },
            "description": "Ngôn ngữ nội dung / content language"
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          },
          {
            "name": "province",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Mã tỉnh (vd. HN)"
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "di_tich",
                "danh_thang",
                "di_san_phi_vat_the",
                "bao_tang",
                "lang_nghe"
              ]
            }
          },
          {
            "name": "level",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "unesco",
                "quoc_gia_dac_biet",
                "quoc_gia",
                "cap_tinh",
                "chua_xep_hang"
              ]
            }
          },
          {
            "name": "period",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tag",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "popular",
                "newest",
                "year"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SiteCard"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/PageMeta"
                    },
                    "links": {
                      "$ref": "#/components/schemas/PageLinks"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/v1/sites/{slug}": {
      "get": {
        "tags": [
          "Heritage"
        ],
        "summary": "Chi tiết di sản (kèm JSON-LD schema.org)",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "locale",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "vi",
                "en"
              ],
              "default": "vi"
            },
            "description": "Ngôn ngữ nội dung / content language"
          },
          {
            "name": "depth",
            "in": "query",
            "schema": {
              "type": "integer",
              "enum": [
                1,
                2,
                3
              ],
              "default": 1
            },
            "description": "1 phổ thông, 2 chuyên sâu, 3 học thuật"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/SiteDetail"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
