  },
  "components": {
    "responses": {
      "NotFound": {
        "description": "Không tìm thấy hoặc chưa công bố"
      },
      "TooManyRequests": {
        "description": "Vượt giới hạn 60 yêu cầu/phút"
      }
    },
    "schemas": {
      "PageMeta": {
        "type": "object",
        "properties": {
          "current_page": {
            "type": "integer"
          },
          "last_page": {
            "type": "integer"
          },
          "per_page": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "locale": {
            "type": "string"
          }
        }
      },
      "PageLinks": {
        "type": "object",
        "properties": {
          "first": {
            "type": [
              "string",
              "null"
            ]
          },
          "last": {
            "type": [
              "string",
              "null"
            ]
          },
          "prev": {
            "type": [
              "string",
              "null"
            ]
          },
          "next": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "NamedRef": {
